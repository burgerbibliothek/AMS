APP_NAME="ARK Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

TIME_ZONE = 'Europe/Zurich'

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
